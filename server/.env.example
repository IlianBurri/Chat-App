# Copy to .env to override the defaults.
PORT=4000
DATABASE_URL="file:./dev.db"
# Required in production. Any long random string.
JWT_SECRET="change-me"
UPLOAD_DIR="uploads"
# Calls: STUN/TURN servers as JSON, needed when people call across networks (not on one machine or in a LAN).
# ICE_SERVERS='[{"urls":"stun:stun.example.org:3478"}]'
# Seconds an incoming call rings before it counts as missed.
# CALL_RING_SECONDS=30
